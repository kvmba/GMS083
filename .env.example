# 复制为 .env 后按需修改：cp .env.example .env

# REST / 游戏端口
TZ=Asia/Shanghai
SERVER_PORT=8686
APP_VUE_URL=http://localhost:8787
GMS_LOGIN_PORT=8484
CHANNEL_PORT_RANGE=7575-7600

# 构建时下载资源使用的 HTTP/HTTPS 代理（运行容器不生效，按需填写）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 数据库（按需修改）
DB_URL=jdbc:mysql://127.0.0.1:3306/GMS083?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&connectTimeout=5000
DB_USERNAME=gms
DB_PASSWORD=gms

# JWT 生产环境务必修改
JWT_SECRET=please-change-me-in-production
JWT_DURATION=1800000

# 游戏服
GMS_LANGUAGE=zh-CN
GMS_WAN_HOST=127.0.0.1
GMS_LAN_HOST=127.0.0.1
GMS_LOCALHOST=127.0.0.1

# Swagger 默认关闭
SWAGGER_ENABLED=false

# 上传大小
MULTIPART_MAX_FILE_SIZE=1MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# 限流
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LIMIT=10
RATE_LIMIT_DURATION=1000
RATE_LIMIT_AUTO_BAN=false
